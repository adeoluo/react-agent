---
title: System Architecture - ReAct Agent
config:
  theme: base
  themeVariables:
    fontFamily: "Inter, system-ui, sans-serif"
    primaryColor: "#F8FAFC"
    primaryBorderColor: "#1E293B"
    primaryTextColor: "#1E293B"
    lineColor: "#64748B"
    clusterBkg: "#EEF2FF"
    clusterBorder: "#94A3B8"
---
flowchart TB
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    Client([Client]):::edge

    subgraph Edge["Service layer (stdlib HTTP, stateless)"]
        direction TB
        Router["Router<br/>GET /health | POST /run"]:::core
        Validate["Validation<br/>bounds: question, max_steps"]:::control
    end

    subgraph Loop["Reason-act loop (bounded by step budget)"]
        direction TB
        Reason["Reason<br/>language model decision"]:::core
        Parse["Parse action<br/>tool + input, or finish"]:::core
        Act["Act<br/>dispatch to a tool"]:::core
        Observe["Observe<br/>tool result"]:::core
    end

    Model{{Language model<br/>rule-policy (offline) or provider}}:::edge

    subgraph Tools["Tool registry (trust boundary, pure)"]
        direction TB
        Calc[calculator]:::data
        Search[search / knowledge base]:::data
        Convert[unit conversion, dates, text]:::data
    end

    Trace["Typed trace<br/>thought, action, observation"]:::obs

    Client -->|JSON request| Router --> Validate
    Validate -->|question| Reason
    Reason -->|completion| Parse
    Model -->|decision| Reason
    Parse -->|tool call| Act
    Act --> Calc
    Act --> Search
    Act --> Convert
    Calc --> Observe
    Search --> Observe
    Convert --> Observe
    Observe -->|within budget| Reason
    Parse -->|finish| Router -->|JSON response + trace| Client
    Observe -.-> Trace
    Parse -.-> Trace
