---
title: System Architecture - ReAct Agent
config:
  theme: base
  themeVariables:
    fontFamily: "Inter, system-ui, sans-serif"
    primaryColor: "#F8FAFC"
    primaryBorderColor: "#1E293B"
    primaryTextColor: "#1E293B"
    lineColor: "#64748B"
    clusterBkg: "#E2E8F0"
    clusterBorder: "#94A3B8"
---
flowchart LR
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef external fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    User([User / CLI]):::external

    subgraph Loop["ReAct Control Loop"]
        Prompt[Prompt builder]:::core
        Parser[Output parser]:::core
        Agent[Agent]:::core
    end

    subgraph Tools["Tool Registry"]
        Calc[(calculator)]:::data
        Search[(search)]:::data
        Memory[(memory)]:::data
    end

    LLM{{Language model}}:::external

    User -->|question| Agent
    Agent -->|build| Prompt
    Prompt -->|prompt| LLM
    LLM -->|completion| Parser
    Parser -->|Action| Agent
    Agent -->|call tool| Calc
    Agent -->|call tool| Search
    Agent -->|call tool| Memory
    Calc -.->|observation| Agent
    Agent -->|Final Answer + trace| User
