flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Cli(["CLI<br/>run, benchmark, serve"]):::edge
        Client(["HTTP client<br/>JSON question"]):::edge
        Router["HTTP router<br/>/health, /run"]:::core
        Validate["Validation<br/>question, max_steps"]:::control
        Cli ~~~ Client --> Router --> Validate
    end

    subgraph Core["ReAct loop"]
        direction TB
        Agent["Agent loop<br/>reason, act, observe"]:::core
        Prompt["Prompt builder<br/>tools, scratchpad"]:::core
        Models["Offline models<br/>rule policy, scripted"]:::core
        Parser["Output parser<br/>action or answer"]:::core
        Budgets["Budgets, recovery<br/>steps, caps, retries"]:::control
        Provider(["OpenAI or Anthropic<br/>optional adapters"]):::edge
        Agent --> Prompt --> Models --> Parser --> Budgets ~~~ Provider
    end

    subgraph State["Tools and state"]
        direction TB
        Registry[("ToolRegistry<br/>10 built-in tools")]:::data
        Kb[("Knowledge base<br/>bundled, offline")]:::data
        Scratch[("Scratchpad<br/>thought, action, obs")]:::data
        Registry --> Kb ~~~ Scratch
    end

    subgraph Obs["Evaluation and logs"]
        direction TB
        Trace["AgentResult trace<br/>typed steps, JSON"]:::obs
        Callbacks["Callbacks<br/>step and action logs"]:::obs
        Bench["Benchmark suite<br/>task success rate"]:::obs
        Metrics["/metrics<br/>Prometheus text"]:::obs
        Trace ~~~ Callbacks ~~~ Bench ~~~ Metrics
    end

    Interfaces -->|question| Core
    Core -->|tool calls| State
    State -.->|steps| Obs
    Core -->|events| Obs
