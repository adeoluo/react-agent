flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    Client(["HTTP client<br/>JSON question"]):::edge
    Cli(["CLI<br/>tools, demonstrate, benchmark, run, serve"]):::edge
    Provider(["OpenAI or Anthropic API<br/>optional adapters"]):::edge

    subgraph Io["Interfaces (stdlib HTTP, stateless)"]
        direction TB
        Router["Request router<br/>/health, /run"]:::core
        Validate["Request validation<br/>question up to 2000 chars,<br/>max_steps 1 to 12"]:::control
    end

    subgraph Loop["Core logic (ReAct loop)"]
        direction TB
        Agent["Agent<br/>reason, act, observe"]:::core
        Prompt["Prompt builder<br/>grammar, tools, scratchpad"]:::core
        Parser["Output parser<br/>action or final answer"]:::core
        Budgets["Budgets and recovery<br/>max_steps, size caps, tool retries"]:::control
        Offline["Offline models<br/>rule policy, scripted"]:::core
    end

    subgraph State["Data and state"]
        direction TB
        Registry[("ToolRegistry<br/>10 built-in tools")]:::data
        Kb[("Bundled knowledge base<br/>search and exact lookup")]:::data
        Scratch[("Scratchpad<br/>thought, action, observation")]:::data
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Trace["AgentResult trace<br/>typed steps, JSON export"]:::obs
        Callbacks["Callbacks<br/>step, action, observation logs"]:::obs
        Bench["Benchmark suite<br/>task success rate"]:::obs
        Metrics["/metrics<br/>Prometheus counts, latency"]:::obs
    end

    Client -->|POST JSON| Router
    Cli -->|serve| Router
    Cli -->|run, demonstrate| Agent
    Cli -->|benchmark| Bench
    Router -.->|checks| Validate
    Router -->|question| Agent
    Agent -->|build| Prompt
    Agent -->|complete| Offline
    Agent -.->|optional| Provider
    Agent -->|parse| Parser
    Agent -.-> Budgets
    Agent -->|call tool| Registry
    Registry -.->|lookup| Kb
    Agent -->|append step| Scratch
    Agent --> Trace
    Agent -.-> Callbacks
    Bench -.->|runs tasks| Agent
    Router -.->|timings| Metrics
